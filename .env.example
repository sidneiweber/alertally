# Copie para .env e preencha. O .env não vai para o git.

# --- Obrigatório ---------------------------------------------------------

# Assina o cookie de sessão. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# OAuth do Google (https://console.cloud.google.com/apis/credentials)
# URI de redirecionamento: https://<seu-host>/login/google/authorized
CLIENT_ID=
CLIENT_SECRET=

# Quem pode entrar (separados por vírgula). Admins sempre podem entrar.
# Sem nenhum dos três, ninguém entra.
ALLOWED_EMAIL_DOMAINS=example.com
ALLOWED_EMAILS=
# Admins podem fechar alertas e remover o ACK de outras pessoas
ADMIN_EMAILS=admin@example.com

# --- Geral ---------------------------------------------------------------

# Fuso usado no "há 5 minutos" e nos horários de ACK (padrão: UTC)
TIMEZONE=UTC

# Catálogo: labels que criam o serviço técnico automaticamente, em ordem de
# prioridade. Vale a primeira presente no alerta (ex.: service,resource)
# CATALOG_SERVICE_LABELS=service,resource
# CATALOG_AUTO_CREATE=true
# Dias sem alertas para marcar um serviço como "sem atividade"
# CATALOG_STALE_DAYS=30

# Duração máxima, em horas, de uma janela de manutenção (só admins criam)
# MAINTENANCE_MAX_HOURS=24

# true quando o HTTPS termina num proxy reverso e o app recebe HTTP: o retorno
# do login do Google e os links gerados passam a usar https://. Também liga
# SESSION_COOKIE_SECURE, a menos que ela esteja definida.
FORCE_HTTPS=false

# true quando o app só é servido por HTTPS (recomendado em produção)
# SESSION_COOKIE_SECURE=false

# MongoDB (no docker-compose já aponta para o serviço "mongo")
# MONGO_URL=127.0.0.1
# MONGO_PORT=27017

# Desenvolvimento local: sem login, usuário fixo local@example.com (admin).
# Nunca use em produção.
# DISABLE_GOOGLE_LOGIN=true

# --- Webhooks --------------------------------------------------------------
# Preencha as credenciais de cada fonte que você usa. Um webhook sem
# credenciais recusa as entregas (503), a menos que a opção abaixo esteja ligada.
# Use só em rede privada. Padrão: false (true com DISABLE_GOOGLE_LOGIN=true).
# ALLOW_UNAUTHENTICATED_WEBHOOKS=false

# GCP Monitoring: canal "Webhook with basic auth"
GCP_WEBHOOK_USER=
GCP_WEBHOOK_PASSWORD=

# Alertmanager: exige "Authorization: Bearer <token>" quando definido
ALERTMANAGER_TOKEN=
# Logs detalhados do webhook (não ativa debug do Flask). Inclui as labels recebidas.
ALERTMANAGER_DEBUG=false

# AWS CloudWatch via SNS: basic auth na URL da assinatura e tópicos aceitos
AWS_SNS_USER=
AWS_SNS_PASSWORD=
AWS_SNS_TOPIC_ARNS=
# Confere a assinatura das mensagens do SNS (padrão: true)
# AWS_SNS_VERIFY_SIGNATURE=true

# Webhook genérico (/events): exige "Authorization: Bearer <token>"
EVENTS_TOKEN=
