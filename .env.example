# Copie para .env e preencha. O .env não vai para o git.

# --- Obrigatório ---------------------------------------------------------

# Assina o cookie de sessão. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# OAuth do Google (https://console.cloud.google.com/apis/credentials)
# URI de redirecionamento: https://<seu-host>/login/google/authorized
CLIENT_ID=
CLIENT_SECRET=

# Quem pode entrar (separados por vírgula). Admins sempre podem entrar.
# Sem nenhum dos três, ninguém entra.
ALLOWED_EMAIL_DOMAINS=example.com
ALLOWED_EMAILS=
# Admins podem fechar alertas e remover o ACK de outras pessoas
ADMIN_EMAILS=admin@example.com

# --- Geral ---------------------------------------------------------------

# Fuso usado no "há 5 minutos" e nos horários de ACK (padrão: UTC)
TIMEZONE=UTC

# true quando o app só é servido por HTTPS (recomendado em produção)
SESSION_COOKIE_SECURE=false

# Necessário quando o HTTPS termina num proxy reverso e o app recebe HTTP
# OAUTHLIB_INSECURE_TRANSPORT=1

# MongoDB (no docker-compose já aponta para o serviço "mongo")
# MONGO_URL=127.0.0.1
# MONGO_PORT=27017

# Desenvolvimento local: sem login, usuário fixo local@example.com (admin).
# Nunca use em produção.
# DISABLE_GOOGLE_LOGIN=true

# --- Webhooks (opcionais) ------------------------------------------------

# GCP Monitoring: canal "Webhook with basic auth"
GCP_WEBHOOK_USER=
GCP_WEBHOOK_PASSWORD=

# Alertmanager: exige "Authorization: Bearer <token>" quando definido
ALERTMANAGER_TOKEN=
# Logs detalhados do webhook (não ativa debug do Flask). Inclui as labels recebidas.
ALERTMANAGER_DEBUG=false

# AWS CloudWatch via SNS: basic auth na URL da assinatura e tópicos aceitos
AWS_SNS_USER=
AWS_SNS_PASSWORD=
AWS_SNS_TOPIC_ARNS=
